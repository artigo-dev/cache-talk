; Copy to .env. Nothing here is secret: the talk runs against a Redis of its
; own, which the scenarios empty (TALK[DEDICATED] says they may).
ENV = development

[REDIS]
HOST = 127.0.0.1
PORT = 6379

[CACHE]
PREFIX = talk

[TALK]
; yes: the scenarios may FLUSHDB this Redis
DEDICATED = no
; yes: the hosted live mode (grid-only parameters, one run at a time)
PUBLIC = no
