; Docker (compose.yaml): Redis is the compose service "redis", and it is the
; talk's own.
ENV = development

[REDIS]
HOST = redis
PORT = 6379

[CACHE]
PREFIX = talk

[TALK]
; yes: the scenarios may FLUSHDB this Redis
DEDICATED = yes
; yes: the hosted live mode (grid-only parameters, one run at a time)
PUBLIC = no
