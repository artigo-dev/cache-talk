; GitHub Actions: Redis is a service container on localhost, and it is the
; talk's own.
ENV = ci

[REDIS]
HOST = 127.0.0.1
PORT = 6379

[CACHE]
PREFIX = talk

[TALK]
; yes: the scenarios may FLUSHDB this Redis
DEDICATED = yes
; yes: the hosted live mode (grid-only parameters, one run at a time)
PUBLIC = no
